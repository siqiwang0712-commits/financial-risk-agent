FINRISK_LLM_PROVIDER=mock
OPENAI_API_KEY=
# Optional: read a secret from a mounted file instead of the environment (wins over
# the plain variable). Supported for DATABASE_URL, OPENAI_API_KEY and
# FINRISK_BOOTSTRAP_TOKEN.
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
FINRISK_LLM_MODEL=gpt-4.1-mini
# HTTPS is required for remote providers; loopback HTTP is allowed for local
# OpenAI-compatible servers. Embedded URL credentials are rejected.
FINRISK_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
FINRISK_LLM_MAX_RETRIES=2
FINRISK_LLM_LOG=logs/llm-calls.jsonl
FINRISK_INPUT_COST_PER_MILLION=0
FINRISK_OUTPUT_COST_PER_MILLION=0
SEC_USER_AGENT=FinRisk-Agent your-email@example.com
# Upload ceiling in bytes. This is a *file* size: the API compares the uploaded PDF
# bytes against it. The Next proxy allows this much plus its multipart framing
# allowance, so a PDF of exactly this size is not rejected before the API sees it.
# FINRISK_MAX_UPLOAD_MB is still honoured as a fallback when the bytes form is unset.
FINRISK_MAX_UPLOAD_BYTES=52428800
FINRISK_MAX_PDF_PAGES=500
FINRISK_MAX_EXTRACTED_CHARS=5000000
FINRISK_ANALYSIS_TIMEOUT_SECONDS=60
FINRISK_RATE_LIMIT=60
# Maximum live rows for the shared rate limiter. Expired rows are swept; live rows
# are never trimmed, and admission fails closed when the cap is reached.
FINRISK_RATE_LIMIT_MAX_ROWS=200000
# Per-member decompression budget for SEC bulk archives (bytes) and the expansion
# multiple above which a member is treated as hostile. Keep the byte budget well under
# the API container's memory limit.
FINRISK_SEC_MAX_ARCHIVE_MEMBER_BYTES=268435456
FINRISK_SEC_MAX_ARCHIVE_COMPRESSION_RATIO=1000
FINRISK_CORS_ORIGINS=http://localhost:3000
FINRISK_ENV=development
# Disabled by default: the route mints ADMIN keys without an API key. Turn it on
# only for first-run provisioning, and never on an interface other clients can reach.
FINRISK_ENABLE_ORG_BOOTSTRAP=0
FINRISK_BOOTSTRAP_TOKEN=
FINRISK_AUTO_MIGRATE=0
DATABASE_URL=
# Only applied when the PostgreSQL volume is *first* initialised. Changing it later
# does not change the password stored in an existing volume — the containers then fail
# to authenticate and PostgreSQL reports `unhealthy`. To rotate: run
# `ALTER USER finrisk WITH PASSWORD '...'` inside the database first, or recreate the
# volume (which destroys its data).
POSTGRES_PASSWORD=
FINRISK_API_UPSTREAM=http://localhost:8000
