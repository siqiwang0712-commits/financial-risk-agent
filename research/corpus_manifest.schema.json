{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finrisk-evaluation-corpus-v1",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": true,
    "required": ["observation_id", "ticker", "cik", "sector", "fiscal_year", "period_end", "filing_date", "accession", "source_url", "source_hash", "source_available_time", "information_cutoff", "outcome_window_end", "split", "annotation_status"],
    "properties": {
      "observation_id": {"type": "string", "minLength": 1},
      "ticker": {"type": "string", "minLength": 1},
      "cik": {"type": "string", "pattern": "^[0-9]{10}$"},
      "sector": {"type": "string"},
      "fiscal_year": {"type": "integer"},
      "period_end": {"type": "string", "format": "date"},
      "filing_date": {"type": "string", "format": "date"},
      "accession": {"type": "string", "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"},
      "source_url": {"type": "string", "format": "uri"},
      "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "source_available_time": {"type": "string", "format": "date-time"},
      "information_cutoff": {"type": "string", "format": "date-time"},
      "outcome_window_end": {"type": "string", "format": "date"},
      "split": {"enum": ["train", "validation", "test"]},
      "annotation_status": {"enum": ["pending", "reviewer_a", "reviewer_b", "adjudicated"]}
    }
  }
}
