    {"id":"CFL_003","category":"cash_flow","severity":"medium","conditions":[{"metric":"fcf_margin","operator":"<","value":-0.05}],"effect":{"score_delta":11},"rationale":"Free-cash-flow deficit is material relative to revenue."},
    {"id":"CFL_004","category":"cash_flow","severity":"medium","conditions":[{"metric":"operating_cash_flow_growth","operator":"<","value":-0.25}],"effect":{"score_delta":10},"rationale":"Operating cash flow declined rapidly."},
    {"id":"CFL_005","category":"cash_flow","severity":"high","conditions":[{"metric":"net_income","operator":">","value":0},{"metric":"free_cash_flow","operator":"<","value":0}],"effect":{"score_delta":15},"rationale":"Positive earnings have not converted into free cash flow."},
    {"id":"CFL_006","category":"cash_flow","severity":"high","conditions":[{"metric":"operating_cash_flow","operator":"<","value":0},{"metric":"short_term_debt_growth","operator":">","value":0.2}],"effect":{"score_delta":18},"rationale":"Cash burn coincides with greater short-term borrowing."},
    {"id":"CFL_007","category":"cash_flow","severity":"medium","conditions":[{"metric":"cfo_to_net_income","operator":"<","value":0.8}],"effect":{"score_delta":10},"rationale":"Cash conversion from reported earnings is weak."},
    {"id":"CFL_008","category":"cash_flow","severity":"critical","conditions":[{"metric":"free_cash_flow_negative_years","operator":">=","value":3}],"effect":{"score_delta":23},"rationale":"Free cash flow has remained negative for at least three years."},

    {"id":"EQ_001","category":"earnings_quality","severity":"high","conditions":[{"metric":"revenue_growth","operator":">","value":0},{"metric":"net_income_growth","operator":">","value":0},{"metric":"operating_cash_flow_growth","operator":"<","value":0}],"effect":{"score_delta":17},"rationale":"Revenue and earnings rose while operating cash flow fell."},
    {"id":"EQ_002","category":"earnings_quality","severity":"high","conditions":[{"metric":"accounts_receivable_growth","operator":">","value":0.25},{"metric":"revenue_growth","operator":"<","value":0.1}],"effect":{"score_delta":16},"rationale":"Receivables growth substantially outpaces revenue growth."},
    {"id":"EQ_003","category":"earnings_quality","severity":"medium","conditions":[{"metric":"inventory_growth","operator":">","value":0.25},{"metric":"revenue_growth","operator":"<","value":0.1}],"effect":{"score_delta":13},"rationale":"Inventory growth outpaces sales and may indicate slowing demand."},
    {"id":"EQ_004","category":"earnings_quality","severity":"high","conditions":[{"metric":"cfo_to_net_income","operator":"<","value":0.5},{"metric":"net_income","operator":">","value":0}],"effect":{"score_delta":16},"rationale":"Reported profit has poor operating cash backing."},
    {"id":"EQ_005","category":"earnings_quality","severity":"medium","conditions":[{"metric":"receivable_days_change","operator":">","value":15}],"effect":{"score_delta":11},"rationale":"Collection period lengthened materially."},
    {"id":"EQ_006","category":"earnings_quality","severity":"medium","conditions":[{"metric":"inventory_days_change","operator":">","value":20}],"effect":{"score_delta":11},"rationale":"Inventory holding period increased materially."},
    {"id":"EQ_007","category":"earnings_quality","severity":"high","conditions":[{"metric":"net_income","operator":">","value":0},{"metric":"operating_cash_flow","operator":"<","value":0}],"effect":{"score_delta":18},"rationale":"Positive net income coincides with negative operating cash flow."},
    {"id":"EQ_008","category":"earnings_quality","severity":"medium","conditions":[{"metric":"cash_conversion_cycle_change","operator":">","value":20}],"effect":{"score_delta":12},"rationale":"The cash conversion cycle deteriorated substantially."},

    {"id":"ACC_001","category":"accounting","severity":"high","conditions":[{"metric":"beneish_m_score","operator":">","value":-1.78}],"effect":{"score_delta":18},"rationale":"Beneish screening indicates elevated manipulation risk; it is not proof."},
    {"id":"ACC_002","category":"accounting","severity":"high","conditions":[{"metric":"restatement_detected","operator":"==","value":true}],"effect":{"score_delta":17},"rationale":"A financial restatement warrants additional accounting review."},
    {"id":"ACC_003","category":"accounting","severity":"medium","conditions":[{"metric":"accrual_ratio","operator":">","value":0.1}],"effect":{"score_delta":12},"rationale":"Accruals are high relative to assets."},
    {"id":"ACC_004","category":"accounting","severity":"medium","conditions":[{"metric":"non_gaap_adjustment_ratio","operator":">","value":0.3}],"effect":{"score_delta":10},"rationale":"Non-GAAP adjustments are large relative to GAAP earnings."},
    {"id":"ACC_005","category":"accounting","severity":"high","conditions":[{"metric":"material_weakness","operator":"==","value":true}],"effect":{"score_delta":18},"rationale":"A disclosed material weakness raises reporting reliability risk."},
    {"id":"ACC_006","category":"accounting","severity":"medium","conditions":[{"metric":"auditor_adjustment","operator":"==","value":true}],"effect":{"score_delta":12},"rationale":"Auditor-related adjustments warrant further review."},
    {"id":"ACC_007","category":"accounting","severity":"medium","conditions":[{"metric":"related_party_growth","operator":">","value":0.3}],"effect":{"score_delta":11},"rationale":"Related-party balances or transactions grew rapidly."},
    {"id":"ACC_008","category":"accounting","severity":"high","conditions":[{"metric":"late_filing","operator":"==","value":true}],"effect":{"score_delta":15},"rationale":"Late filing can indicate reporting process stress."},

    {"id":"GOV_001","category":"governance_audit","severity":"critical","conditions":[{"metric":"adverse_audit_opinion","operator":"==","value":true}],"effect":{"score_delta":28},"rationale":"An adverse audit opinion is a severe reporting risk signal."},
    {"id":"GOV_002","category":"governance_audit","severity":"high","conditions":[{"metric":"qualified_audit_opinion","operator":"==","value":true}],"effect":{"score_delta":20},"rationale":"A qualified audit opinion limits assurance."},
    {"id":"GOV_003","category":"governance_audit","severity":"medium","conditions":[{"metric":"auditor_change","operator":"==","value":true}],"effect":{"score_delta":11},"rationale":"Auditor change warrants contextual review."},
    {"id":"GOV_004","category":"governance_audit","severity":"high","conditions":[{"metric":"auditor_resignation","operator":"==","value":true}],"effect":{"score_delta":18},"rationale":"Auditor resignation is a significant governance signal."},
    {"id":"GOV_005","category":"governance_audit","severity":"medium","conditions":[{"metric":"related_party_material","operator":"==","value":true}],"effect":{"score_delta":12},"rationale":"Material related-party transactions increase governance complexity."},
    {"id":"GOV_006","category":"governance_audit","severity":"medium","conditions":[{"metric":"ceo_cfo_turnover","operator":"==","value":true}],"effect":{"score_delta":10},"rationale":"Senior finance leadership turnover may weaken oversight continuity."},
    {"id":"GOV_007","category":"governance_audit","severity":"high","conditions":[{"metric":"internal_control_ineffective","operator":"==","value":true}],"effect":{"score_delta":18},"rationale":"Ineffective internal controls weaken reporting assurance."},
    {"id":"GOV_008","category":"governance_audit","severity":"medium","conditions":[{"metric":"board_independence_low","operator":"==","value":true}],"effect":{"score_delta":10},"rationale":"Limited board independence may weaken monitoring."},

    {"id":"BUS_001","category":"business_going_concern","severity":"critical","conditions":[{"metric":"going_concern_doubt","operator":"==","value":true}],"effect":{"score_delta":30},"rationale":"Explicit substantial-doubt language indicates severe continuity risk."},
    {"id":"BUS_002","category":"business_going_concern","severity":"high","conditions":[{"metric":"covenant_breach","operator":"==","value":true}],"effect":{"score_delta":22},"rationale":"A covenant breach can accelerate refinancing pressure."},
    {"id":"BUS_003","category":"business_going_concern","severity":"high","conditions":[{"metric":"refinancing_dependency","operator":"==","value":true}],"effect":{"score_delta":18},"rationale":"Operations depend materially on successful refinancing."},
    {"id":"BUS_004","category":"business_going_concern","severity":"medium","conditions":[{"metric":"customer_concentration","operator":">","value":0.3}],"effect":{"score_delta":12},"rationale":"High customer concentration increases revenue fragility."},
    {"id":"BUS_005","category":"business_going_concern","severity":"medium","conditions":[{"metric":"supplier_concentration","operator":">","value":0.3}],"effect":{"score_delta":10},"rationale":"High supplier concentration increases operational fragility."},
    {"id":"BUS_006","category":"business_going_concern","severity":"high","conditions":[{"metric":"material_litigation","operator":"==","value":true}],"effect":{"score_delta":16},"rationale":"Material litigation may create financial or operational pressure."},
    {"id":"BUS_007","category":"business_going_concern","severity":"high","conditions":[{"metric":"regulatory_investigation","operator":"==","value":true}],"effect":{"score_delta":17},"rationale":"A disclosed regulatory investigation increases uncertainty."},
    {"id":"BUS_008","category":"business_going_concern","severity":"medium","conditions":[{"metric":"demand_weakness","operator":"==","value":true}],"effect":{"score_delta":11},"rationale":"Management reports material demand weakness."},

    {"id":"REF_001","category":"liquidity","severity":"high","conditions":[{"metric":"debt_due_12m_ratio","operator":">","value":0.4},{"metric":"cash_ratio","operator":"<","value":0.25}],"effect":{"score_delta":18},"rationale":"Near-term debt maturities are large relative to liquidity."},
    {"id":"REF_002","category":"solvency_leverage","severity":"high","conditions":[{"metric":"floating_rate_debt_ratio","operator":">","value":0.6},{"metric":"interest_coverage","operator":"<","value":3}],"effect":{"score_delta":15},"rationale":"Floating-rate exposure combines with limited interest headroom."},
    {"id":"REF_003","category":"liquidity","severity":"medium","conditions":[{"metric":"unused_facility_ratio","operator":"<","value":0.1}],"effect":{"score_delta":10},"rationale":"Available committed borrowing capacity is limited."},
    {"id":"REF_004","category":"business_going_concern","severity":"high","conditions":[{"metric":"debt_maturity_concentration","operator":">","value":0.5}],"effect":{"score_delta":16},"rationale":"Debt maturities are highly concentrated."}
