{
  "version": "1.0.0",
  "description": "Expert-designed heuristic risk signals. Signals are not findings of fraud or default.",
  "rules": [
    {"id":"LIQ_001","category":"liquidity","severity":"high","conditions":[{"metric":"current_ratio","operator":"<","value":1.0}],"effect":{"score_delta":18},"rationale":"Current assets do not cover current liabilities."},
    {"id":"LIQ_002","category":"liquidity","severity":"medium","conditions":[{"metric":"current_ratio","operator":"<","value":1.25}],"effect":{"score_delta":9},"rationale":"Liquidity cushion is thin."},
    {"id":"LIQ_003","category":"liquidity","severity":"high","conditions":[{"metric":"quick_ratio","operator":"<","value":0.75}],"effect":{"score_delta":14},"rationale":"Liquid assets provide weak short-term coverage."},
    {"id":"LIQ_004","category":"liquidity","severity":"medium","conditions":[{"metric":"cash_ratio","operator":"<","value":0.15}],"effect":{"score_delta":8},"rationale":"Immediate cash coverage is limited."},
    {"id":"LIQ_005","category":"liquidity","severity":"high","conditions":[{"metric":"working_capital","operator":"<","value":0}],"effect":{"score_delta":16},"rationale":"Negative working capital increases short-term funding pressure."},
    {"id":"LIQ_006","category":"liquidity","severity":"medium","conditions":[{"metric":"cash_growth","operator":"<","value":-0.2}],"effect":{"score_delta":10},"rationale":"Cash declined materially year over year."},
    {"id":"LIQ_007","category":"liquidity","severity":"high","conditions":[{"metric":"current_ratio","operator":"<","value":1.0},{"metric":"short_term_debt_growth","operator":">","value":0.2},{"metric":"cash_growth","operator":"<","value":0}],"effect":{"score_delta":18},"rationale":"Deteriorating liquidity combines with rising refinancing pressure."},
    {"id":"LIQ_008","category":"liquidity","severity":"high","conditions":[{"metric":"cash_growth","operator":"<","value":-0.25},{"metric":"operating_cash_flow_growth","operator":"<","value":-0.2}],"effect":{"score_delta":15},"rationale":"Both cash reserves and operating cash generation weakened."},

    {"id":"SOL_001","category":"solvency_leverage","severity":"high","conditions":[{"metric":"debt_to_equity","operator":">","value":2.0}],"effect":{"score_delta":17},"rationale":"Debt is high relative to book equity."},
    {"id":"SOL_002","category":"solvency_leverage","severity":"medium","conditions":[{"metric":"debt_to_assets","operator":">","value":0.5}],"effect":{"score_delta":10},"rationale":"Debt finances more than half of assets."},
    {"id":"SOL_003","category":"solvency_leverage","severity":"high","conditions":[{"metric":"liabilities_to_assets","operator":">","value":0.85}],"effect":{"score_delta":16},"rationale":"Asset coverage of total liabilities is narrow."},
    {"id":"SOL_004","category":"solvency_leverage","severity":"high","conditions":[{"metric":"interest_coverage","operator":"<","value":1.5}],"effect":{"score_delta":18},"rationale":"Operating earnings weakly cover interest expense."},
    {"id":"SOL_005","category":"solvency_leverage","severity":"medium","conditions":[{"metric":"interest_coverage","operator":"<","value":3.0}],"effect":{"score_delta":9},"rationale":"Interest coverage has limited headroom."},
    {"id":"SOL_006","category":"solvency_leverage","severity":"high","conditions":[{"metric":"debt_to_ebitda","operator":">","value":5.0}],"effect":{"score_delta":18},"rationale":"Debt burden is high relative to EBITDA."},
    {"id":"SOL_007","category":"solvency_leverage","severity":"medium","conditions":[{"metric":"total_debt_growth","operator":">","value":0.25}],"effect":{"score_delta":10},"rationale":"Debt increased rapidly."},
    {"id":"SOL_008","category":"solvency_leverage","severity":"critical","conditions":[{"metric":"shareholder_equity","operator":"<","value":0}],"effect":{"score_delta":25},"rationale":"Negative book equity is a severe solvency signal."},

    {"id":"PRO_001","category":"profitability","severity":"high","conditions":[{"metric":"net_margin","operator":"<","value":0}],"effect":{"score_delta":15},"rationale":"The company is loss-making at net income level."},
    {"id":"PRO_002","category":"profitability","severity":"medium","conditions":[{"metric":"operating_margin","operator":"<","value":0.03}],"effect":{"score_delta":9},"rationale":"Operating profitability is thin."},
    {"id":"PRO_003","category":"profitability","severity":"medium","conditions":[{"metric":"gross_margin_change","operator":"<","value":-0.03}],"effect":{"score_delta":10},"rationale":"Gross margin contracted materially."},
    {"id":"PRO_004","category":"profitability","severity":"high","conditions":[{"metric":"operating_margin_change","operator":"<","value":-0.05}],"effect":{"score_delta":14},"rationale":"Operating margin deteriorated sharply."},
    {"id":"PRO_005","category":"profitability","severity":"medium","conditions":[{"metric":"revenue_growth","operator":"<","value":-0.1}],"effect":{"score_delta":10},"rationale":"Revenue declined materially."},
    {"id":"PRO_006","category":"profitability","severity":"high","conditions":[{"metric":"net_income_growth","operator":"<","value":-0.3}],"effect":{"score_delta":14},"rationale":"Net income deteriorated substantially."},
    {"id":"PRO_007","category":"profitability","severity":"medium","conditions":[{"metric":"roa","operator":"<","value":0}],"effect":{"score_delta":9},"rationale":"Assets are generating accounting losses."},
    {"id":"PRO_008","category":"profitability","severity":"high","conditions":[{"metric":"revenue_growth","operator":"<","value":0},{"metric":"operating_margin","operator":"<","value":0}],"effect":{"score_delta":16},"rationale":"Revenue contraction and operating losses coincide."},

    {"id":"CFL_001","category":"cash_flow","severity":"high","conditions":[{"metric":"operating_cash_flow","operator":"<","value":0}],"effect":{"score_delta":17},"rationale":"Core operations consume cash."},
