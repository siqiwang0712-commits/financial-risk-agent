# Example environment for the published container stack:
#
#   cp .env.release.example .env
#   $EDITOR .env                       # fill in every value marked REQUIRED
#   docker compose -f docker-compose.release.yml pull
#   docker compose -f docker-compose.release.yml up -d
#
# This file targets `docker-compose.release.yml` (published GHCR images). For the
# source build use `.env.example` with `docker-compose.yml` instead — that file sets
# `FINRISK_ENV=development` and assumes the API is reached directly, neither of which
# applies here.
#
# The stack hardcodes `FINRISK_ENV=production`, so the organisation bootstrap route is
# token-gated. Read "FIRST RUN" below before starting: a fresh deployment with
# bootstrap off has no way to create its first administrator, and there is no other
# provisioning path (no preset admin key, no CLI). That is deliberate, but it means
# the order matters.

# ---------------------------------------------------------------------------
# REQUIRED — PostgreSQL
# ---------------------------------------------------------------------------
# Applied only when the data volume is *first* initialised. Changing it later does not
# change the password inside an existing volume; the containers then fail to
# authenticate and PostgreSQL reports `unhealthy`. To rotate, either `ALTER USER finrisk
# WITH PASSWORD '...'` inside the database first, or recreate the volume (destroying
# its data).
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# REQUIRED — which LLM the analysis proxy talks to
# ---------------------------------------------------------------------------
# Unset is an error (the stack fails closed rather than guessing). Use `openai` for a
# real run; `mock` is a deterministic test provider and is NOT a production default.
FINRISK_LLM_PROVIDER=openai
FINRISK_LLM_MODEL=gpt-4.1-mini
FINRISK_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
FINRISK_LLM_MAX_RETRIES=2
FINRISK_LLM_MAX_TOKENS=1200

# Prefer the `_FILE` form: mount the secret as a file (Docker secret, Kubernetes
# projected volume) so the value never appears in `docker inspect` or a shell history.
# `<VAR>_FILE` wins over `<VAR>` when set. Supported for DATABASE_URL, OPENAI_API_KEY
# and FINRISK_BOOTSTRAP_TOKEN.
OPENAI_API_KEY=
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key

# ---------------------------------------------------------------------------
# FIRST RUN — provisioning the first administrator
# ---------------------------------------------------------------------------
# In `FINRISK_ENV=production` the bootstrap route needs BOTH of these:
#   * `FINRISK_ENABLE_ORG_BOOTSTRAP=1` — otherwise every call returns
#     403 "organization bootstrap is disabled".
#   * a non-empty `FINRISK_BOOTSTRAP_TOKEN` — otherwise every call returns
#     403 "invalid bootstrap token" (an unset expected token can never match).
#
# A fresh database has no organisation and no API key, so with either one missing the
# stack starts, reports healthy, and is unusable.
FINRISK_ENABLE_ORG_BOOTSTRAP=1
FINRISK_BOOTSTRAP_TOKEN=
# FINRISK_BOOTSTRAP_TOKEN_FILE=/run/secrets/finrisk_bootstrap_token

# ---------------------------------------------------------------------------
# AFTER THE FIRST RUN — turn bootstrap off
# ---------------------------------------------------------------------------
# Once you have provisioned an organisation and stored its API key:
#   1. set FINRISK_ENABLE_ORG_BOOTSTRAP=0
#   2. clear FINRISK_BOOTSTRAP_TOKEN
#   3. `docker compose -f docker-compose.release.yml up -d` to recreate the API
# The route mints ADMIN keys without any API key of its own, so it must not stay
# reachable on an interface other clients can use.

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------
# Upload ceiling in bytes (a *file* size; the proxy allows this plus multipart framing).
FINRISK_MAX_UPLOAD_BYTES=52428800
FINRISK_MAX_PDF_PAGES=500
FINRISK_MAX_EXTRACTED_CHARS=5000000
# Per-request analysis budget. The timeout smoke test overrides this to 0.001.
FINRISK_ANALYSIS_TIMEOUT_SECONDS=60
FINRISK_RATE_LIMIT=60
FINRISK_RATE_LIMIT_MAX_ROWS=200000
# Per-member decompression budget for SEC bulk archives, and the expansion multiple
# above which a member is treated as hostile. Keep the byte budget well under the API
# container's 1G memory limit.
FINRISK_SEC_MAX_ARCHIVE_MEMBER_BYTES=268435456
FINRISK_SEC_MAX_ARCHIVE_COMPRESSION_RATIO=1000
SEC_USER_AGENT=FinRisk-Agent your-email@example.com

# Optional cost accounting for LLM usage (0 disables).
FINRISK_INPUT_COST_PER_MILLION=0
FINRISK_OUTPUT_COST_PER_MILLION=0

# ---------------------------------------------------------------------------
# Pinning (optional, recommended for reproducible deployments)
# ---------------------------------------------------------------------------
# The compose file defaults to `:${FINRISK_VERSION:-v0.3.3}`. A tag can be repointed;
# a digest cannot. Override to pin one audited build, e.g.
#   FINRISK_VERSION=sha-<full-commit-sha>
# or set the full reference with an explicit digest:
#   FINRISK_API_IMAGE=ghcr.io/siqiwang0712-commits/financial-risk-agent-api:v0.3.3@sha256:<digest>
#   FINRISK_WEB_IMAGE=ghcr.io/siqiwang0712-commits/financial-risk-agent-web:v0.3.3@sha256:<digest>
# Never deploy from `latest` if you need reproducibility.
