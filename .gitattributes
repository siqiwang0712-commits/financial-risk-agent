* text=auto

# PDFs are binary. Without this, `text=auto` treats a generated PDF as text: git
# rewrites its line endings on checkout, which shifts the byte offsets the xref
# table points at, and the `git diff --check HEAD^ HEAD` CI gate reports the
# binary content as trailing whitespace.
*.pdf binary

# Reproducible research artifacts must have identical bytes on Windows and Linux.
research/results/public_v1/*.csv text eol=lf
research/results/public_v1/*.json text eol=lf
research/results/public_v1/*.svg text eol=lf
research/results/v0.3.1/*.csv text eol=lf
research/results/v0.3.1/*.json text eol=lf
research/results/v0.3.1/*.svg text eol=lf

# Frozen forensic manifests hash exact artifact bytes. Preserve their original
# CRLF byte representation on every platform instead of applying text filters.
research/results/v0.3.1/benchmark_forensics/**/*.json -text
# Derived cross-experiment reports are not immutable byte-hashed artifacts.
research/results/v0.3.1/benchmark_forensics/*.json text eol=lf

# Frozen study artifacts under research/e4 and research/e5 carry content hashes and are
# compared byte-for-byte across platforms. They previously inherited only `* text=auto`,
# so a Windows checkout with core.autocrlf=true produced CRLF working-tree copies of
# research/e4/public/*.json and research/e4/protocol/*. Pin them to LF.
research/e4/** text eol=lf
research/e5/** text eol=lf
research/e4_statistical_audit/** text eol=lf

# The published replication bundle ships one gzipped intermediate. The `eol=lf` rule
# above would otherwise force a text filter on it, so it is marked binary explicitly;
# later rules win.
research/e4_statistical_audit/replication/*.gz binary

# E4-R publishes a manifest of SHA-256 digests over its own outputs, so those bytes have
# to survive a Windows/Linux round trip unchanged. The figure writer opens its output
# binary for the same reason: matplotlib would otherwise emit CRLF for the SVGs.
research/e4r_automated_robustness/** text eol=lf
research/e4r_automated_robustness/oof_predictions.csv text eol=lf
